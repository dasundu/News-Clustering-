# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# Embeddings come from the Gemini API by default, so this is required unless
# you switch EMBEDDING_PROVIDER to local. Get one at aistudio.google.com/apikey
# (a permanent key starts with "AIza"; short-lived tokens will expire mid-run).
GEMINI_API_KEY=your_gemini_api_key_here

# ── Embeddings ────────────────────────────────────────────────────────────
# gemini = hosted API. No local model, no torch — deployable on a small host,
#          and the only mode where /search works on the lightweight API image.
#          ~$1.64/year at ~222 articles/day. Free tier allows 1000/day.
# local  = paraphrase-multilingual-MiniLM-L12-v2 in process. Offline, free,
#          fully deterministic; needs `pip install -r requirements-local.txt`.
#
# SWITCHING PROVIDERS RE-EMBEDS THE WHOLE CORPUS and invalidates every
# similarity threshold in config.py. Run compare_embeddings.py afterwards to
# re-derive them; leaving the old values collapses clustering silently.
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSION=768

# Free-tier pacing. Quota is charged per embedded item (1000/day), so a full
# backfill needs several days unless billing is enabled. Both can be relaxed
# once it is — they only smooth out bursts.
GEMINI_EMBED_BATCH=25
GEMINI_EMBED_SLEEP=1.0
EMBED_COMMIT_CHUNK=25

# ── Pipeline ──────────────────────────────────────────────────────────────
# Minutes between pipeline runs (scrape -> extract -> clean -> embed -> cluster).
SCRAPE_INTERVAL=60

# ── API ───────────────────────────────────────────────────────────────────
API_PORT=8000

# Set false on any publicly reachable deployment: every write route then
# returns 503. This API has no authentication.
# PIPELINE_ENABLED=false

# Set false to disable /search (e.g. to stop a host making Gemini calls).
# SEARCH_ENABLED=false
